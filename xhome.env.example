# Xhome — Raspberry Pi environment.  Install to /etc/xhome.env (chmod 600).
#
#   sudo cp xhome.env.example /etc/xhome.env
#   sudo chmod 600 /etc/xhome.env
#   sudo nano /etc/xhome.env
#
# Nothing in this repo contains a real credential; fill these in yourself.

# Where the Pi publishes. Include the stream key / credentials your ingest wants.
RTMP_URL="rtmp://rtmp.example.com:1935/live?user=USER&pass=PASSWORD"

# Unix user the broadcast service runs as.
XHOME_USER="pi"

# --- LTE (only if using a cellular modem) -----------------------------
APN="your.apn"
APN_USER=""
APN_PASS=""
