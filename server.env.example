# Xhome — broadcast server environment (Windows).
# Set these as system environment variables, or edit the defaults in the scripts.

# Source stream the transcoder and archiver read from (your RTMP ingest).
RTMP_SOURCE=rtmp://ingest:1935/live?user=USER&pass=PASSWORD

APP_DIR=C:\broadcast      # scripts, HLS output, JSON state
ARCHIVE_DIR=D:\xhome      # recordings + GPS logs
PI_HOST=192.168.1.50      # the Raspberry Pi, for the ping health check
